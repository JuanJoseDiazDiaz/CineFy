<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tema principal de la app -->
    <style name="Theme.Cinefy" parent="android:Theme.Material.Light.NoActionBar"/>

    <style name="Theme.Cinefy.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/cinefylogo</item>
        <item name="windowSplashScreenAnimationDuration">3000</item>
        <item name="postSplashScreenTheme">@style/Theme.Cinefy</item>
    </style>
</resources>